# ─────────────────────────────────────────────────────────────────────────────
# Rhadix — Productieconfiguratie
# Kopieer dit bestand naar .env en vul de waarden in.
# Het .env bestand nooit committen naar git (staat al in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Versie van Rhadix die wordt uitgerold (opgegeven door leverancier)
RHADIX_VERSION=1.3.1

# GitHub organisatie van de leverancier (wordt ingevuld bij uitlevering)
GHCR_ORG=rhadix

# ── Licentie ─────────────────────────────────────────────────────────────────
# Ontvangen van Rhadix bij aanschaf. Verplicht veld.
RHADIX_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX

# ── Database ──────────────────────────────────────────────────────────────────
# Kies een sterk wachtwoord. Wordt alleen intern gebruikt.
DB_USER=kikv
DB_PASSWORD=verander_dit_naar_een_sterk_wachtwoord
DB_NAME=kikv_validator

# ── Poortnummers (pas aan bij conflicten op uw server) ───────────────────────
FRONTEND_PORT=5174
BACKEND_PORT=8010

# ── GHCR toegang voor auto-updates (Watchtower) ───────────────────────────────
# Maak aan op github.com → Settings → Developer settings → Personal access tokens
# Vereiste scope: read:packages
GHCR_USER=uw-github-gebruikersnaam
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Fuseki triple store (Reconciliation Engine — SPARQL op data) ──────────────
# Wachtwoord voor de admin-user van de Fuseki triple store (interne service).
# Standaard 'rhadix-prod-admin' als niet gezet.
FUSEKI_PASSWORD=rhadix-prod-admin

# Zet op 0 om de admin-bootstrap bij startup over te slaan (standaard aan).
# Niet-destructief: borgt alleen dat admin@rhadix.nl bestaat; wist nooit gebruikers.
AUTH_RESET=1
