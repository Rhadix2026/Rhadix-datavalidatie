# ─────────────────────────────────────────────────────────────────────────────
# Rhadix — Staging omgevingsconfiguratie
# ─────────────────────────────────────────────────────────────────────────────
# Kopieer dit bestand op de server naar: /opt/rhadix-app/.env.staging
# Vul alle waarden in. Dit bestand NOOIT in Git committen.
#
# Gebruik:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Container Registry organisatie (leverancier)
GHCR_ORG=rhadix2026

# ── Licentie ──────────────────────────────────────────────────────────────────
# Kan dezelfde licentie zijn als productie, of een aparte staging-licentie.
STAGING_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX

# ── Database ──────────────────────────────────────────────────────────────────
# ANDERE database dan productie — nooit dezelfde wachtwoorden gebruiken!
STAGING_DB_USER=kikv_staging
STAGING_DB_PASSWORD=verander_dit_naar_een_sterk_staging_wachtwoord
STAGING_DB_NAME=kikv_staging

# ── Poorten ───────────────────────────────────────────────────────────────────
# ANDERE poorten dan productie (productie: 5174 / 8010)
STAGING_FRONTEND_PORT=5175
STAGING_BACKEND_PORT=8011
