# ONGEWIJZIGDE SPARQL-query uit KIK-V Publicatieplatform,
# Uitwisselprofiel Zorgkantoren Inkoopondersteuning en beleidsontwikkeling 1.3.5
# (publicatie 15-07-2026, commit c064e4d68ec1c58a58f26091982e31201fcc652e).
# Letterlijk overgenomen; bij uitvoering wordt uitsluitend een BIND van een
# parameter geactiveerd. Bron: CC BY-ND 4.0, naamsvermelding KIK-V.
# Indicator: Zorgkantoren 15.2
# Parameters: ?zorgkantoor
# Ontologie: versie 2.2.0 of nieuwer

PREFIX onz-org: <http://purl.org/ozo/onz-org#>
PREFIX onz-g: <http://purl.org/ozo/onz-g#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT 
    (?vestiging AS ?Indeling)
    (COUNT(DISTINCT ?wooneenheid) AS ?Aantal_bezette_wooneenheden)
WHERE {
    ?wooneenheid a onz-org:WoonEenheid .

    FILTER EXISTS {
        ?wooneenheid onz-g:hasQuality ?OccQual .
        ?OccQual a onz-g:OccupancyQuality .
        ?OccQual onz-g:hasQualityValue ?occQualV .
    }

    {
        # Per vestiging
        ?wooneenheid onz-g:partOf ?locatie .
        ?locatie 
            a onz-g:StationaryArtifact ;
            onz-g:partOf* ?vestiging_uri .
        ?vestiging_uri a onz-org:Vestiging ;
            onz-g:hasLocalizableArea/onz-g:identifiedBy/onz-g:hasPart/onz-g:hasPart ?postcode_6 ;
            onz-g:identifiedBy ?vest_nr .

        BIND(IRI(SUBSTR(STR(?postcode_6), 1, STRLEN(STR(?postcode_6)) - 2)) AS ?postcode)

        ?pc_gebied 
            onz-g:identifiedBy ?postcode ;
            onz-g:partOf+ ?zk_regio .
        ?zk_regio a onz-org:ZorgkantoorRegio .
        ?zorgkantoor onz-g:hasOperatingRange ?zk_regio .

        ?vest_nr a onz-org:Vestigingsnummer ;
            onz-g:hasDataValue ?vestiging .
    }
    UNION
    {
        # Totaal organisatie (inclusief bezette wooneenheden zonder vestiging)
        BIND("Organisatie (gecontracteerd + algemeen)" AS ?vestiging)
    }
}
GROUP BY ?vestiging
ORDER BY ?vestiging
