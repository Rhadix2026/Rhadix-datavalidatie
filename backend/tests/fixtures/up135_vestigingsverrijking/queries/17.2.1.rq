# ONGEWIJZIGDE SPARQL-query uit de bronrepository
# gitlab.com/kik-v/uitwisselprofielen/uitwisselprofiel-zorgkantoren, tag 1.3.5
# (commit c064e4d68ec1, 15-07-2026). Letterlijk overgenomen; bij uitvoering wordt
# uitsluitend een BIND van een parameter geactiveerd.
# Bron: CC BY-ND 4.0, naamsvermelding KIK-V.
# Indicator: Zorgkantoren 17.2.1
# Parameters: 
# Ontologie: 

SELECT
    ?Naam_vestiging
    ?Gemeente
    ?Toename_afname
    ?Leveringsvorm
    ?Gepland_aantal_cliënten
    ?Fase
    ?Beoogde_datum_ingebruikname
WHERE {
  {
    # Explanatory row
    BIND("Vul hier de naam van de vestiging in die van toepassing is." AS ?Naam_vestiging)
    BIND("Vul hier de gemeente in waar deze vestiging zich bevindt" AS ?Gemeente)
    BIND("Kies uit: Toename of Afname" AS ?Toename_afname)    
    BIND("Kies uit: Intramuraal of VPT-geclusterd" AS ?Leveringsvorm)            
    BIND("Vul hier het aantal geplande cliënten in" AS ?Gepland_aantal_cliënten) 
    BIND("Kies uit: Concept, Initiatie, Definitie, Ontwerp, Voorbereiding & realisatie, Gerealiseerd, Geannuleerd" AS ?Fase)
    BIND("Vul hier de beoogde datum van ingebruikname in" AS ?Beoogde_datum_ingebruikname)
  }
  UNION
  {
    # Two placeholder rows for each Leveringsvorm
    VALUES (?Naam_vestiging ?Gemeente 
            ?Toename_afname
            ?Leveringsvorm 
            ?Gepland_aantal_cliënten 
            ?Fase 
            ?Beoogde_datum_ingebruikname) {
        ("" "" "" "" "" "" "")
        ("" "" "" "" "" "" "")
        ("" "" "" "" "" "" "")
        ("" "" "" "" "" "" "")
        ("" "" "" "" "" "" "")
    }
  }
}
