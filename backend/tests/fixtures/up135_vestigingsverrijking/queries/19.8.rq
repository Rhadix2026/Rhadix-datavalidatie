# ONGEWIJZIGDE SPARQL-query uit KIK-V Publicatieplatform,
# Uitwisselprofiel Zorgkantoren Inkoopondersteuning en beleidsontwikkeling 1.3.5
# (publicatie 15-07-2026, commit c064e4d68ec1c58a58f26091982e31201fcc652e).
# Letterlijk overgenomen; bij uitvoering wordt uitsluitend een BIND van een
# parameter geactiveerd. Bron: CC BY-ND 4.0, naamsvermelding KIK-V.
# Indicator: Zorgkantoren 19.8 - Liquiditeit (Cashflow)
# Parameters: ?startperiode, ?eindperiode
# Ontologie: versie 3.0.0 of nieuwer

PREFIX onz-fin: <http://purl.org/ozo/onz-fin#>
PREFIX onz-g:   <http://purl.org/ozo/onz-g#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>


SELECT
    ("Cashflow" AS ?Kental)
    (
        IF(?noemer = 0,
            "Ongedefinieerd"^^xsd:string,
            ROUND((?teller / ?noemer) * 100) / 100) AS ?Waarde
    )
WHERE {

    # ========================================================================
    # DEEL 1: Resultatenrekening in EEN scan
    #   levert S Resultaat na belastingen, Q.VI Afschrijvingen en R.IV Rentelasten
    # ========================================================================
    {
        SELECT
            (
                ?p_totaal + ?q_totaal + ?r_i_totaal + ?r_ii_totaal + ?r_iii_totaal + 
                (?r_iv_plus_totaal - ?r_iv_min_totaal) + 
                ?s_i_totaal + ?s_ii_totaal 
                AS ?S_resultaat
            )
            (?q_vi_totaal AS ?Q_VI)
            ((?r_iv_plus_totaal - ?r_iv_min_totaal) AS ?R_IV)
        WHERE {
            SELECT
                (SUM(?p_bedrag)         AS ?p_totaal)
                (SUM(?q_bedrag)         AS ?q_totaal)
                (SUM(?q_vi_bedrag)      AS ?q_vi_totaal)
                (SUM(?r_i_bedrag)       AS ?r_i_totaal)
                (SUM(?r_ii_bedrag)      AS ?r_ii_totaal)
                (SUM(?r_iii_bedrag)     AS ?r_iii_totaal)
                (SUM(?r_iv_plus_bedrag) AS ?r_iv_plus_totaal)
                (SUM(?r_iv_min_bedrag)  AS ?r_iv_min_totaal)
                (SUM(?s_i_bedrag)       AS ?s_i_totaal)
                (SUM(?s_ii_bedrag)      AS ?s_ii_totaal)
            WHERE {
                # BIND("2024-01-01"^^xsd:date AS ?startperiode)
                # BIND("2024-12-31"^^xsd:date AS ?eindperiode)

                ?grootboek_post
                    a onz-fin:Grootboekpost ;
                    onz-g:partOf ?rubriek ;
                    onz-g:hasDate ?datum ;
                    onz-fin:heeftGeldBedrag ?geld_bedrag .

                # Directe ouder: Grootboekrekening (RGS) of Grootboekrubriek (Prismant)
                { { ?rubriek a onz-fin:Grootboekrekening } UNION { ?rubriek a onz-fin:Grootboekrubriek } }
                # Anti-dubbeltelling: alleen bladniveau
                FILTER NOT EXISTS {
                    ?grootboek_post onz-g:partOf ?child .
                    ?child onz-g:partOf ?rubriek .
                    FILTER(?child != ?rubriek)
                    { { ?child a onz-fin:Grootboekrekening } UNION { ?child a onz-fin:Grootboekrubriek } }
                }
                FILTER(STRSTARTS(STR(?rubriek), STR(onz-fin:)))
                BIND(STRAFTER(STR(?rubriek), STR(onz-fin:)) AS ?rubriekCode)
                FILTER(?datum >= ?startperiode && ?datum <= ?eindperiode)

                # --- P Som der bedrijfsopbrengsten ---
                BIND(
                    IF(
                        STRSTARTS(?rubriekCode, "81")  || STRSTARTS(?rubriekCode, "82")  ||
                        STRSTARTS(?rubriekCode, "83")  || STRSTARTS(?rubriekCode, "89")  ||
                        STRSTARTS(?rubriekCode, "919") || STRSTARTS(?rubriekCode, "920") ||
                        STRSTARTS(?rubriekCode, "930") ||
                        
                        STRSTARTS(?rubriekCode, "WOmz") || STRSTARTS(?rubriekCode, "WRev") ||
                        STRSTARTS(?rubriekCode, "WRvi") || STRSTARTS(?rubriekCode, "WRgr") ||
                        STRSTARTS(?rubriekCode, "WWvv") || STRSTARTS(?rubriekCode, "WNoa") ||
                        STRSTARTS(?rubriekCode, "WLbe") || STRSTARTS(?rubriekCode, "WBat") ||
                        STRSTARTS(?rubriekCode, "WWiv") || STRSTARTS(?rubriekCode, "WOvb"),
                        ?geld_bedrag, 0) AS ?p_bedrag)

                # --- Q Som der bedrijfslasten (incl. Q.VI Afschrijvingen) ---
                BIND(
                    IF(
                        STRSTARTS(?rubriekCode, "417")  || STRSTARTS(?rubriekCode, "418")  ||
                        STRSTARTS(?rubriekCode, "411")  || STRSTARTS(?rubriekCode, "412")  ||
                        STRSTARTS(?rubriekCode, "413")  || STRSTARTS(?rubriekCode, "414")  ||
                        STRSTARTS(?rubriekCode, "415")  || STRSTARTS(?rubriekCode, "416")  ||
                        STRSTARTS(?rubriekCode, "419")  || STRSTARTS(?rubriekCode, "420")  ||
                        STRSTARTS(?rubriekCode, "4221") || STRSTARTS(?rubriekCode, "4223") ||
                        STRSTARTS(?rubriekCode, "4224") || STRSTARTS(?rubriekCode, "4225") ||
                        STRSTARTS(?rubriekCode, "4229") || STRSTARTS(?rubriekCode, "4226") ||
                        STRSTARTS(?rubriekCode, "480")  || STRSTARTS(?rubriekCode, "481")  ||
                        STRSTARTS(?rubriekCode, "482")  || STRSTARTS(?rubriekCode, "483")  ||
                        STRSTARTS(?rubriekCode, "484")  || STRSTARTS(?rubriekCode, "423")  ||
                        STRSTARTS(?rubriekCode, "43")   || STRSTARTS(?rubriekCode, "44")   ||
                        STRSTARTS(?rubriekCode, "45")   || STRSTARTS(?rubriekCode, "46")   ||
                        STRSTARTS(?rubriekCode, "47")   || STRSTARTS(?rubriekCode, "486")  ||
                        STRSTARTS(?rubriekCode, "489")  || STRSTARTS(?rubriekCode, "905")  ||
                        STRSTARTS(?rubriekCode, "911")  || STRSTARTS(?rubriekCode, "912")  ||
                        STRSTARTS(?rubriekCode, "913")  || STRSTARTS(?rubriekCode, "914")  ||
                        STRSTARTS(?rubriekCode, "915")  || STRSTARTS(?rubriekCode, "921")  ||
                        STRSTARTS(?rubriekCode, "931")  ||
                        
                        STRSTARTS(?rubriekCode, "WKpr") || STRSTARTS(?rubriekCode, "WPer") ||
                        STRSTARTS(?rubriekCode, "WAfs") || STRSTARTS(?rubriekCode, "WWvi") ||
                        STRSTARTS(?rubriekCode, "WBwv") || STRSTARTS(?rubriekCode, "WBed") ||
                        STRSTARTS(?rubriekCode, "WOok") || STRSTARTS(?rubriekCode, "WKol") ||
                        STRSTARTS(?rubriekCode, "WVkf") || STRSTARTS(?rubriekCode, "WAkf"),
                        ?geld_bedrag, 0) AS ?q_bedrag)

                # --- Q.VI Afschrijvingen op (im)materiele vaste activa (deelverzameling van Q) ---
                # Prismant: 480-484, RGS: WAfs
                BIND(
                    IF(
                        STRSTARTS(?rubriekCode, "480") || STRSTARTS(?rubriekCode, "481") ||
                        STRSTARTS(?rubriekCode, "482") || STRSTARTS(?rubriekCode, "483") ||
                        STRSTARTS(?rubriekCode, "484") || 
                        
                        STRSTARTS(?rubriekCode, "WAfs"),
                        ?geld_bedrag, 0) AS ?q_vi_bedrag)

                # --- R.I  (Prismant 904 / RGS WOvt) ---
                BIND(IF(STRSTARTS(?rubriekCode, "904") || STRSTARTS(?rubriekCode, "WOvt"), ?geld_bedrag, 0) AS ?r_i_bedrag)
                # --- R.II (Prismant 900 / RGS WFbeRlm) ---
                BIND(IF(STRSTARTS(?rubriekCode, "900") || STRSTARTS(?rubriekCode, "WFbeRlm"), ?geld_bedrag, 0) AS ?r_ii_bedrag)
                # --- R.III (Prismant 903 / RGS WWfa, WVhe) ---
                BIND(IF(STRSTARTS(?rubriekCode, "903") || STRSTARTS(?rubriekCode, "WWfa") || STRSTARTS(?rubriekCode, "WVhe"), ?geld_bedrag, 0) AS ?r_iii_bedrag)
                # --- R.IV Rentelasten (Prismant 485/901 / RGS WFbe - WFbeRlm) ---
                BIND(IF(STRSTARTS(?rubriekCode, "485") || STRSTARTS(?rubriekCode, "901") || STRSTARTS(?rubriekCode, "WFbe"), ?geld_bedrag, 0) AS ?r_iv_plus_bedrag)
                BIND(IF(STRSTARTS(?rubriekCode, "WFbeRlm"), ?geld_bedrag, 0) AS ?r_iv_min_bedrag)
                # --- S.I  (RGS WBel) ---
                BIND(IF(STRSTARTS(?rubriekCode, "WBel"), ?geld_bedrag, 0) AS ?s_i_bedrag)
                # --- S.II (Prismant 902 / RGS WRed, WAad) ---
                BIND(IF(STRSTARTS(?rubriekCode, "902") || STRSTARTS(?rubriekCode, "WRed") || STRSTARTS(?rubriekCode, "WAad"), ?geld_bedrag, 0) AS ?s_ii_bedrag)
            }
        }
    }

    # ========================================================================
    # DEEL 2a: F Langlopende schulden op peildatum VOOR begin meetperiode
    # ========================================================================
    {
        SELECT (SUM(?rubriek_balans) AS ?saldoVoor)
        WHERE {
            SELECT ?rubriek
            	(COALESCE(SAMPLE(?saldo_bedrag), 0) + SUM(COALESCE(?post_bedrag, 0)) AS ?rubriek_balans) 
            WHERE {
                # BIND("2024-01-01"^^xsd:date AS ?startperiode)

                # peildatum is altijd één dag voor de startdatum 
                # (dit is dus géén testparameter en moet uitgecomment blijven!)
                BIND(?startperiode + "-P1D"^^xsd:duration AS ?peildatum_voor)

                { ?rubriek a onz-fin:Grootboekrubriek } UNION { ?rubriek a onz-fin:Grootboekrekening }
                BIND(STRAFTER(STR(?rubriek), STR(onz-fin:)) AS ?rubriekCode)
                FILTER(STRSTARTS(?rubriekCode, "07") || ?rubriekCode = "BLas")

                # Laatste EindSaldo op of voor de peildatum (optioneel)
                OPTIONAL {
                    ?rubriek onz-g:isAbout ?saldo .
                    ?saldo a onz-fin:EindSaldo ;
                           onz-fin:heeftGeldBedrag ?saldo_bedrag ;
                           onz-g:hasDate ?saldo_datum .
                    FILTER(?saldo_datum <= ?peildatum_voor)
                    FILTER NOT EXISTS {
                        ?rubriek onz-g:isAbout ?saldo2 .
                        ?saldo2 a onz-fin:EindSaldo ; onz-g:hasDate ?saldo_datum2 .
                        FILTER(?saldo2 != ?saldo && ?saldo_datum2 <= ?peildatum_voor)
                        FILTER(?saldo_datum2 > ?saldo_datum
                               || (?saldo_datum2 = ?saldo_datum && STR(?saldo2) > STR(?saldo)))
                    }
                }
                # Posten NA het saldo (of alle posten als er geen saldo is) t/m peildatum
                OPTIONAL {
                    ?post a onz-fin:Grootboekpost ;
                          onz-g:partOf ?rubriek ;
                          onz-g:hasDate ?post_datum ;
                          onz-fin:heeftGeldBedrag ?post_bedrag .
                    FILTER NOT EXISTS {
                        ?post onz-g:partOf ?fijner . ?fijner onz-g:partOf+ ?rubriek .
                    }
                    FILTER(?post_datum <= ?peildatum_voor && (!BOUND(?saldo_datum) || ?post_datum > ?saldo_datum))
                }
            }
            GROUP BY ?rubriek ?peildatum_voor
        }
    }

    # ========================================================================
    # DEEL 2b: F Langlopende schulden op peildatum LAATSTE dag meetperiode
    # ========================================================================
    {
        SELECT (SUM(?rubriek_balans) AS ?saldoNa)
        WHERE {
            SELECT ?rubriek
            	(COALESCE(SAMPLE(?saldo_bedrag), 0) + SUM(COALESCE(?post_bedrag, 0)) AS ?rubriek_balans)
            WHERE {
                # BIND("2024-12-31"^^xsd:date AS ?eind_periode)

                { ?rubriek a onz-fin:Grootboekrubriek } UNION { ?rubriek a onz-fin:Grootboekrekening }
                BIND(STRAFTER(STR(?rubriek), STR(onz-fin:)) AS ?rubriekCode)
                FILTER(STRSTARTS(?rubriekCode, "07") || ?rubriekCode = "BLas")

                OPTIONAL {
                    ?rubriek onz-g:isAbout ?saldo .
                    ?saldo a onz-fin:EindSaldo ;
                           onz-fin:heeftGeldBedrag ?saldo_bedrag ;
                           onz-g:hasDate ?saldo_datum .
                    FILTER(?saldo_datum <= ?eind_periode)
                    FILTER NOT EXISTS {
                        ?rubriek onz-g:isAbout ?saldo2 .
                        ?saldo2 a onz-fin:EindSaldo ; onz-g:hasDate ?saldo_datum2 .
                        FILTER(?saldo2 != ?saldo && ?saldo_datum2 <= ?eind_periode)
                        FILTER(?saldo_datum2 > ?saldo_datum
                               || (?saldo_datum2 = ?saldo_datum && STR(?saldo2) > STR(?saldo)))
                    }
                }
                OPTIONAL {
                    ?post a onz-fin:Grootboekpost ;
                          onz-g:partOf ?rubriek ;
                          onz-g:hasDate ?post_datum ;
                          onz-fin:heeftGeldBedrag ?post_bedrag .
                    FILTER NOT EXISTS {
                        ?post onz-g:partOf ?fijner . ?fijner onz-g:partOf+ ?rubriek .
                    }
                    FILTER(?post_datum <= ?eind_periode && (!BOUND(?saldo_datum) || ?post_datum > ?saldo_datum))
                }
            }
            GROUP BY ?rubriek
        }
    }

    # Uitgaven ter aflossing van leningen = F(begin) - F(eind)
    BIND(?saldoVoor - ?saldoNa AS ?aflossing)

    # Teller Cashflow: S + Q.VI afschrijvingen
    BIND(?S_resultaat - ?Q_VI AS ?teller)

    # Noemer Cashflow: R.IV rentelasten + aflossing van Stap 1 in Berekening
    BIND(?R_IV + ?aflossing AS ?noemer)
}
ORDER BY ?Kental
