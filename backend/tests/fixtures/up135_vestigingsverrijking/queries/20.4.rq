# ONGEWIJZIGDE SPARQL-query uit KIK-V Publicatieplatform,
# Uitwisselprofiel Zorgkantoren Inkoopondersteuning en beleidsontwikkeling 1.3.5
# (publicatie 15-07-2026, commit c064e4d68ec1c58a58f26091982e31201fcc652e).
# Letterlijk overgenomen; bij uitvoering wordt uitsluitend een BIND van een
# parameter geactiveerd. Bron: CC BY-ND 4.0, naamsvermelding KIK-V.
# Indicator: Zorgkantoren 20.4.0
# Parameters: ?peildatum
# Ontologie: versie 3.0.0 of nieuwer

PREFIX onz-fin: <http://purl.org/ozo/onz-fin#>
prefix onz-zorg:  <http://purl.org/ozo/onz-zorg#>
PREFIX onz-g: <http://purl.org/ozo/onz-g#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?Kental ?Waarde
WHERE {
    {
        SELECT (SUM(IF(?jaarrekeningpost = "D Reserves", ?bedrag, 0)) AS ?reserves)
        WHERE {
            {
                SELECT ?jaarrekeningpost (SUM(?bedrag_rubriek) AS ?bedrag)
                WHERE {
                    # BIND("2024-12-31"^^xsd:date AS ?peildatum)                     
                    BIND(?peildatum AS ?peildatum_argument)
                    {
                        SELECT  # totaal per rubriek
                            ?rubriek ?categorie
                            (SUM(?geld_bedrag_post) + SUM(?saldo_waarde)/COUNT(?saldo_waarde) AS ?bedrag_rubriek)
                        WHERE {
                            {
                                SELECT  # bereken het meest recente saldo per rubriek, 0 indien geen saldo
                                    ?rubriek ?categorie
                                    (IF(BOUND(?saldo_bedrag), ?saldo_bedrag, 0) AS ?saldo_waarde)
                                    ?peildatum_argument
                                    (IF(BOUND(?saldo_datum), ?saldo_datum, ?unbound) AS ?begin_datum)
                                    ?saldo_datum ?saldo
                                WHERE {
                                    # BIND("2024-12-31"^^xsd:date AS ?peildatum)                                     
									BIND(?peildatum as ?peildatum_argument)

                                    {
                                        # Prismant: prefix-mapping, want Prismant consolideert niet dus we willen onderliggende rubrieken
                                        {
                                        ?rubriek a onz-fin:Grootboekrubriek .
                                        }
                                        UNION
                                        {
                                        ?rubriek a onz-fin:Grootboekrekening .
                                        }
                                        BIND(STRAFTER(STR(?rubriek), STR(onz-fin:)) AS ?rubriekCode)

                                        VALUES (?prismantPrefix ?categorie) {
                                        ("05413" "D.IV")
                                        ("05311" "D.V")
                                        ("05342" "D.V")
                                        ("05423" "D.V")
                                        ("05323" "D.VI")
                                        ("0539"  "D.VII")
                                        ("05493" "D.VII")
                                        ("05915" "D.VII")
                                        ("091"   "D.VIII")
                                        }
                                        FILTER(STRSTARTS(?rubriekCode, ?prismantPrefix))
                                    }
                                    UNION
                                    {
                                        # RGS: exacte mapping, want RGS consolideert zelf onderliggende rubrieken
                                        VALUES (?rubriekCode ?categorie) {
                                            ("BEivHer" "D.III")
                                            ("BEivWer" "D.IV")
                                            ("BEivStr" "D.IV")
                                            ("BEivBer" "D.V")
                                            ("BEivBef" "D.VI")
                                            ("BEivOvr" "D.VII")
                                            ("BEivOre" "D.VIII")
                                        }
                                    
                                        BIND(IRI(CONCAT(STR(onz-fin:), ?rubriekCode)) AS ?rubriek)
                                            {
                                            ?rubriek a onz-fin:Grootboekrubriek .
                                            }
                                            UNION
                                            {
                                            ?rubriek a onz-fin:Grootboekrekening .
                                            }
                                    }

                                    OPTIONAL {
                                        ?rubriek onz-g:isAbout ?saldo .
                                        ?saldo
                                            a onz-fin:EindSaldo ;
                                            onz-fin:heeftGeldBedrag ?saldo_bedrag ;
                                            onz-g:hasDate ?saldo_datum .

                                        FILTER (?saldo_datum <= ?peildatum_argument)

                                        FILTER NOT EXISTS {  
                                            ?rubriek onz-g:isAbout ?saldo2 .
                                            ?saldo2
                                                a onz-fin:EindSaldo ;
                                            onz-g:hasDate ?saldo_datum2 .

                                            FILTER(?saldo2 != ?saldo)
                                            FILTER (?saldo_datum2 <= ?peildatum_argument)
                                            FILTER (
                                                ?saldo_datum2 > ?saldo_datum 
                                                || (
                                                    ?saldo_datum2 = ?saldo_datum 
                                                    && STR(?saldo2) > STR(?saldo)
                                                )
                                            )
                                        }
                                    }
                                }
                            }
                            OPTIONAL {
                                ?grootboek_post
                                    a onz-fin:Grootboekpost ;
                                    onz-g:partOf ?rubriek ;
                                    onz-g:hasDate ?datum ;
                                    onz-fin:heeftGeldBedrag ?geld_bedrag_temp .
                                # Behoud de grootboek post alleen voor de meest specifieke rubriek, 
                                # om dubbeltelling bij meerdere rubrieken te voorkomen
                                FILTER NOT EXISTS {
                                  ?grootboek_post onz-g:partOf ?specifiekereRubriek .
                                  ?specifiekereRubriek onz-g:partOf+ ?rubriek .
                                }
                                FILTER (?datum <= ?peildatum_argument && (?datum > ?begin_datum || !BOUND(?begin_datum)))
                            }
                            BIND(IF(BOUND(?geld_bedrag_temp), ?geld_bedrag_temp, 0) AS ?geld_bedrag_post)

                        } GROUP BY ?rubriek ?categorie
                    }

                    VALUES (?categorie ?jaarrekeningpost){
                    ("D.III"  "D Reserves")
                    ("D.IV"   "D Reserves")
                    ("D.V"    "D Reserves")
                    ("D.VI"   "D Reserves")
                    ("D.VII"  "D Reserves")
                    ("D.VIII" "D Reserves")
                }
                } GROUP BY ?jaarrekeningpost
            }
        }
    }
    
    BIND("Reserves" AS ?Kental)
    BIND(
    ROUND(xsd:decimal(?reserves))
    AS ?Waarde
)
}
ORDER BY ?Kental
